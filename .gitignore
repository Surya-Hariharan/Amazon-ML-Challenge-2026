# Data and generated artefacts — never committed (CLAUDE.md §3, §4)
# dataset/ content (the ~2.5 GB train/test TSVs) is ignored; dataset/README.md
# (documentation, not data) is the one file we still want tracked.
dataset/*
!dataset/README.md

# code/artifacts/ content (cached embeddings, trained models, OOF preds, TF-IDF
# matrices) is ignored; the four subdirectory placeholders are kept so the scaffold
# survives a clone. This is where config.ARTIFACTS_DIR actually resolves (CODE_DIR is
# code/ since the 2026-09-25 flatten of code/business_entity_resolution/ -> code/).
code/artifacts/*
!code/artifacts/models/
!code/artifacts/embeddings/
!code/artifacts/indexes/
!code/artifacts/cache/
code/artifacts/models/*
code/artifacts/embeddings/*
code/artifacts/indexes/*
code/artifacts/cache/*
!code/artifacts/models/.gitkeep
!code/artifacts/embeddings/.gitkeep
!code/artifacts/indexes/.gitkeep
!code/artifacts/cache/.gitkeep

scratch/
# The unzipped organizer bundle (holds the ~2.4 GB dataset) if it lands in the repo root
*_student_resource/
__MACOSX/

# Regenerated by every run, not a source of truth
experiments.csv
# experiments/logs and experiments/results are regenerable and can grow large; keep them
# ignored (but tracked as empty scaffolding via .gitkeep). experiments/configs and
# experiments/reports are meant to stay small and human-readable, so they are NOT
# ignored here — see experiments/README.md.
experiments/logs/*
!experiments/logs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: these must stay TRACKED — never add them (or a blanket *.md) here:
#   README.md, LICENSE, CLAUDE.md                          (repo root — CLAUDE.md must
#                                                            stay at root: Claude Code
#                                                            only auto-loads it from
#                                                            there, not from docs/)
#   docs/planning/plan.md                                   (checkpoint plan; moved from
#                                                            repo root on 2026-09-25)
#   code/README.md                                         (organizer-required)
#   docs/methodology/Documentation_template.md             (organizer-required; moved
#                                                            here from repo root on
#                                                            2026-09-25 — copied back to
#                                                            the zip root at packaging,
#                                                            see docs/planning/plan.md
#                                                            CP12)
#   dataset/README.md, utils/README.md, output/README.md,
#   resources/README.md                                    (documentation, not data —
#                                                            see the explicit
#                                                            allow-rules above)
